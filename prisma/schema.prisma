datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum MemberType {
  PATIENT
  FAMILY
  CLINICIAN
}

enum ClinicianStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum BoardGroup {
  SYMPTOM
  TREATMENT
  COMMUNITY
}

enum BoardStatus {
  ACTIVE
  PENDING
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportTarget {
  POST
  REPLY
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id                   String                   @id @default(cuid())
  name                 String?
  email                String?                  @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  /// Free-form display name: any text, any length, duplicates allowed.
  nickname             String
  profileComplete      Boolean                  @default(false)
  role                 UserRole                 @default(USER)
  memberType           MemberType               @default(PATIENT)
  clinicianStatus      ClinicianStatus          @default(NONE)
  accounts             Account[]
  sessions             Session[]
  posts                Post[]
  replies              Reply[]
  boardApplications    BoardApplication[]
  clinicianApplication ClinicianApplication?
  reports              Report[]
  passwordResets       PasswordResetToken[]
  emailVerifications   EmailVerificationToken[]
  /// Any JWT minted before this instant is refused on its next refresh. Set on
  /// password reset / change so a stolen session dies with the old password.
  sessionsInvalidBefore   DateTime?
  /// True only for the built-in tombstone account that inherits content from
  /// deleted users who chose to keep their posts. Cannot log in (no password,
  /// no linked OAuth account) and is filtered out of member-facing listings.
  isSystem             Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([nickname])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Board {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String      @db.Text
  group       BoardGroup
  status      BoardStatus @default(ACTIVE)
  officialMd  String      @db.Text
  createdAt   DateTime    @default(now())
  posts       Post[]
}

model BoardApplication {
  id          String            @id @default(cuid())
  proposerId  String
  proposer    User              @relation(fields: [proposerId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  group       BoardGroup
  description String            @db.Text
  rationale   String            @db.Text
  status      ApplicationStatus @default(PENDING)
  reviewNote  String?           @db.Text
  createdAt   DateTime          @default(now())

  @@index([status])
}

model ClinicianApplication {
  id         String            @id @default(cuid())
  userId     String            @unique
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  specialty  String
  proofPath  String?
  statement  String            @db.Text
  status     ApplicationStatus @default(PENDING)
  reviewNote String?           @db.Text
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([status])
}

model Post {
  id          String    @id @default(cuid())
  boardId     String
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  bodyMd      String    @db.Text
  isAnonymous Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?
  replies     Reply[]

  @@index([boardId, deletedAt, createdAt])
  @@index([boardId, createdAt])
  @@index([authorId])
}

model Reply {
  id           String    @id @default(cuid())
  postId       String
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId     String
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  bodyMd       String    @db.Text
  isAnonymous  Boolean   @default(false)
  floor        Int
  replyToFloor Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?

  @@unique([postId, floor])
  @@index([postId, createdAt])
  @@index([authorId])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType ReportTarget
  targetId   String
  reason     String       @db.Text
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
  /// Set once an admin alert (email and/or webhook) has gone out for this
  /// report, so the digest job never notifies twice for the same row.
  notifiedAt DateTime?

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([notifiedAt])
}

/// Single-use password reset grant. Only the SHA-256 of the token is stored,
/// so a database leak cannot be replayed against the reset endpoint.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use email ownership proof. `email` records the address the token was
/// issued for, so changing the address invalidates a token already in flight.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Fixed-window counter shared by every serverless instance. `id` is
/// "<bucket>:<windowStart epoch ms>", so a single atomic upsert both creates
/// and increments the window. Expired rows are swept by the nightly cron.
model RateLimitCounter {
  id          String   @id
  bucket      String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@index([expiresAt])
  @@index([bucket])
}
