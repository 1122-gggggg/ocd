datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum MemberType {
  PATIENT
  FAMILY
  CLINICIAN
}

enum ClinicianStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum BoardGroup {
  SYMPTOM
  TREATMENT
  COMMUNITY
}

enum BoardStatus {
  ACTIVE
  PENDING
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportTarget {
  POST
  REPLY
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum SupportSourceType {
  POST
  REPLY
  CHAT
  CHECKIN
}

enum SupportDetectionType {
  REASSURANCE_SEEKING
  COMPULSION_LOOP
  CRISIS
  NEUTRAL
}

enum SupportAction {
  EMPATHY_SHIELD
  URGE_SURFING_PROMPT
  LOOP_EDUCATION
  CRISIS_ESCALATE
}

enum PostSupportMode {
  EMPATHY
  SHARE_EXPERIENCE
  FACING_OCD
  LOOKING_FOR_EXPERIENCE
}

enum ReactionTargetType {
  POST
  REPLY
  VICTORY
}

enum SupportReactionType {
  UNDERSTAND
  HOLD_ON
  RELATABLE
  GRATEFUL
  RESISTED
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String?               @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  /// Free-form display name: any text, any length, duplicates allowed.
  nickname             String
  profileComplete      Boolean               @default(false)
  role                 UserRole              @default(USER)
  memberType           MemberType            @default(PATIENT)
  clinicianStatus      ClinicianStatus       @default(NONE)
  accounts             Account[]
  sessions             Session[]
  posts                Post[]
  replies              Reply[]
  boardApplications    BoardApplication[]
  clinicianApplication ClinicianApplication?
  reports              Report[]
  chatMessages         ChatMessage[]
  supportInteractions  SupportInteraction[]
  recoveryGoals        RecoveryGoal[]
  recoveryLogs         RecoveryLog[]
  victories            Victory[]
  supportReactions     SupportReaction[]
  supportPreference    SupportPreference?
  notifications        Notification[]
  helpfulVotes         HelpfulVote[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([nickname])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Board {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String      @db.Text
  group       BoardGroup
  status      BoardStatus @default(ACTIVE)
  officialMd  String      @db.Text
  createdAt   DateTime    @default(now())
  posts       Post[]

  @@index([status, slug])
}

model BoardApplication {
  id          String            @id @default(cuid())
  proposerId  String
  proposer    User              @relation(fields: [proposerId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  group       BoardGroup
  description String            @db.Text
  rationale   String            @db.Text
  status      ApplicationStatus @default(PENDING)
  reviewNote  String?           @db.Text
  createdAt   DateTime          @default(now())

  @@index([status, createdAt])
  @@index([slug, status])
  @@index([proposerId])
}

model ClinicianApplication {
  id         String            @id @default(cuid())
  userId     String            @unique
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  specialty  String
  proofPath  String?
  statement  String            @db.Text
  status     ApplicationStatus @default(PENDING)
  reviewNote String?           @db.Text
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([status, createdAt])
}

model Post {
  id          String    @id @default(cuid())
  boardId     String
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  bodyMd      String    @db.Text
  isAnonymous Boolean   @default(false)
  isSolved    Boolean   @default(false)
  solvedReplyId String?
  helpfulCount Int      @default(0)
  searchTsv   Unsupported("tsvector")? @map("search_tsv")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?
  replies     Reply[]
  tags        PostTag[]
  supportMode PostSupportMode @default(EMPATHY)

  @@index([boardId, deletedAt, createdAt])
  @@index([boardId, createdAt])
  @@index([authorId])
  @@index([deletedById])
}

model Reply {
  id           String    @id @default(cuid())
  postId       String
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId     String
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  bodyMd       String    @db.Text
  isAnonymous  Boolean   @default(false)
  floor        Int
  replyToFloor Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedById  String?
  searchTsv   Unsupported("tsvector")? @map("search_tsv")

  @@unique([postId, floor])
  @@index([postId, createdAt])
  @@index([postId, deletedAt, floor])
  @@index([authorId])
  @@index([deletedById])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType ReportTarget
  targetId   String
  reason     String       @db.Text
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  channel   String   @default("general")
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
  @@index([senderId, createdAt])
}

model SupportInteraction {
  id           String                @id @default(cuid())
  userId       String
  sourceType   SupportSourceType
  sourceId     String?
  detectedType SupportDetectionType?
  confidence   Float?
  userAction   SupportAction?
  recommendedAction String?
  outcome           String?
  metadata          Json?
  createdAt    DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([detectedType, createdAt])
}

model RecoveryGoal {
  id        String   @id @default(cuid())
  userId    String
  title     String
  target    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs RecoveryLog[]

  @@index([userId, active])
}

model RecoveryLog {
  id         String   @id @default(cuid())
  userId     String
  goalId     String?
  situation          String?       @db.Text
  trigger            String?       @db.Text
  urge               String?       @db.Text
  compulsion         String?       @db.Text
  response           String?       @db.Text
  difficulty         Int?
  difficultyBefore   Int?
  difficultyAfter    Int?
  durationSeconds    Int?
  compulsionResisted Boolean       @default(false)
  createdAt          DateTime      @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal RecoveryGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([goalId])
}

model Victory {
  id          String   @id @default(cuid())
  userId      String
  content     String   @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

model SupportReaction {
  id           String              @id @default(cuid())
  userId       String
  targetType   ReactionTargetType
  targetId     String
  reactionType SupportReactionType
  createdAt    DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId, reactionType])
  @@index([targetType, targetId])
  @@index([userId])
}

model SupportPreference {
  id                   String          @id @default(cuid())
  userId               String          @unique
  preferredSupportMode PostSupportMode @default(EMPATHY)
  hideSensitiveTopics  Boolean         @default(false)
  preferredTopics      String[]        @default([])
  allowPeerMatching    Boolean         @default(true)
  showRecoveryPrompts  Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tag {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  posts     PostTag[]
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([postId])
  @@index([tagId])
}

model HelpfulVote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([userId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientId String?
  postId      String?
  replyId     String?
  kind        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}
