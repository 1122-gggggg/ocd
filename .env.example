# ── Database ──────────────────────────────────────────────────────────
# DATABASE_URL (pooled, runtime): MUST include ?sslmode=require&pgbouncer=true&connection_limit=10
#   → Serverless (Vercel) pooled via Neon PgBouncer (-pooler host). Required for connection limits.
# DIRECT_URL (direct, migrations): MUST NOT have pgbouncer=true or -pooler
#   → Used by `prisma migrate deploy` (needs direct connection, no prepared-statement pooling).
#
# Neon templates (commented — replace <user>/<pass>/<ep-xxx>):
#   DATABASE_URL="postgresql://<user>:<pass>@ep-xxx-pooler.ap-northeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10"
#   DIRECT_URL="postgresql://<user>:<pass>@ep-xxx.ap-northeast-1.aws.neon.tech/neondb?sslmode=require"
# Neon example URLs:
#   pooled: postgresql://user:pass@ep-xxx-pooler.ap-northeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10
#   direct: postgresql://user:pass@ep-xxx.ap-northeast-1.aws.neon.tech/neondb?sslmode=require

# Local dev defaults (active — no pgbouncer, local postgres):
DATABASE_URL=postgresql://ocd:ocd@localhost:5433/ocd?schema=public
DIRECT_URL=postgresql://ocd:ocd@localhost:5433/ocd?schema=public

# ── Auth ──────────────────────────────────────────────────────────────
# AUTH_SECRET: generate with `openssl rand -base64 32` (min 32 chars, required)
#   e.g. AUTH_SECRET=$(openssl rand -base64 32)
AUTH_SECRET=dev-insecure-auth-secret-min-32-chars-ok
AUTH_URL=http://localhost:3001
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SEED_ADMIN_PASSWORD=changeme-admin

# ── R2 (Cloudflare R2 / S3-compatible) ────────────────────────────────
# Required Vercel envs for uploads (see src/lib/r2.ts — r2Enabled flag):
#   R2_ACCOUNT_ID      — Cloudflare account ID (xxx in https://xxx.r2.cloudflarestorage.com)
#   R2_ACCESS_KEY_ID   — R2 API token access key
#   R2_SECRET_ACCESS_KEY — R2 API token secret
#   R2_BUCKET          — bucket name (default: ocd-proofs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ocd-proofs
