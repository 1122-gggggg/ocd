{
  "name": "ocd",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:seed": "npx prisma db seed",
    "postinstall": "prisma generate || true",
    "load:k6": "k6 run k6/load.js",
    "load:artillery": "artillery run artillery.yml",
    "admin:password": "npx tsx scripts/set-admin-password.ts",
    "smoke": "npx tsx scripts/smoke-e2e.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1124.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^3.0.3",
    "next": "15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.5.4"
  },
  "_notes": {
    "sentry": "Not installed. To enable error monitoring run `npm i @sentry/nextjs`, then follow the TODO in next.config.ts (withSentry is a no-op wrapper) and instrumentation.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "prisma": "^6.16.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
